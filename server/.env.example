# Copy this file to .env and fill it in.  cp .env.example .env
# NEVER commit .env — it is already listed in server/.gitignore.

# ---------------------------------------------------------------------------
# Which market data feed to use
#   simulator  - default. No credentials, no network. Prices are invented.
#   upstox     - live Upstox feed. Recommended: the token lasts a year.
#   kite       - live Zerodha Kite WebSocket ticker (token expires DAILY)
#   kite-rest  - Zerodha Kite REST polling, ~1s refresh
# ---------------------------------------------------------------------------
FINOSTAT_FEED=simulator

FINOSTAT_HOST=127.0.0.1

# Local only. On Railway / Render / Fly, leave FINOSTAT_PORT UNSET so the server
# picks up the $PORT they inject -- setting it makes the deploy look healthy
# while the site is unreachable.
FINOSTAT_PORT=8000

# ---------------------------------------------------------------------------
# Upstox  (recommended)
# ---------------------------------------------------------------------------
# 1. Sign in at https://account.upstox.com/developer/apps
# 2. Create an app, then generate an ANALYTICS TOKEN (not a regular access
#    token). Analytics tokens are valid for ONE YEAR and need no daily login.
# 3. Paste it below, with no quotes and no spaces around the "=".
#
# Read-only: it cannot place orders. Still treat it as a password.
UPSTOX_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Zerodha Kite  (alternative — note the daily token expiry)
# ---------------------------------------------------------------------------
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
FINOSTAT_POLL_INTERVAL=1.1

# ---------------------------------------------------------------------------
# Sheet shape
# ---------------------------------------------------------------------------
FINOSTAT_SYMBOL=NIFTY
FINOSTAT_SHEET_ROWS=9
FINOSTAT_SHEET_STEP=50
FINOSTAT_SHEET_WING=100
FINOSTAT_MINI_SYMBOL=BANKNIFTY
FINOSTAT_SIM_INTERVAL=0.2

# ---------------------------------------------------------------------------
# News wire
# ---------------------------------------------------------------------------
FINOSTAT_NEWS_REFRESH=120
